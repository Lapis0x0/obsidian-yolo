# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules
vendor/
/runtime/

# Don't include the compiled files in the repo.
# They should be uploaded to GitHub releases instead.
main.js
meta.json
worker-meta.json
styles.css

# Runtime component assets (e.g. embedding-engine's onnxruntime-web wasm
# binaries) are large, reproducible build outputs copied from node_modules —
# never commit them. `dist/entry.js` and `registry.json` (which records each
# asset's byteSize/sha256) stay tracked; distribution mirrors/uploads the
# actual bytes at release time. See scripts/build-runtime-components.mjs and
# scripts/distribution.mjs.
runtime-components/*/dist/assets/

# Exclude sourcemaps
*.map

# obsidian
data.json

